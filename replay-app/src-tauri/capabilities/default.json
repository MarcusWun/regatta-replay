{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "dialog:allow-open",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-home-read-recursive",
    "fs:allow-document-read-recursive",
    "fs:allow-download-read-recursive",
    {
      "identifier": "sql:allow-load",
      "allow": [{ "sqlite": "sqlite:*" }]
    },
    "sql:allow-select",
    "sql:allow-close",
    "store:default",
    "store:allow-get",
    "store:allow-set",
    "store:allow-save",
    "store:allow-load",
    "store:allow-delete",
    "store:allow-has"
  ]
}
